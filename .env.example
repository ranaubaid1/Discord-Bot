# Discord Bot Authentication Token (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel Mapping: JSON format keyword -> Channel ID (Required)
# Must include "default" fallback channel ID
DISCORD_CHANNEL_MAP={"default": 123456789012345678, "python": 123456789012345678}

# Upwork Job Search URLs to monitor (comma-separated, Required)
UPWORK_SEARCH_URLS=https://www.upwork.com/nx/search/jobs/?q=python&sort=recency

# Polling Interval in seconds (Optional, default: 300)
MONITOR_INTERVAL=300

# Browser mode for Playwright: headless or headed (Optional, default: headless)
BROWSER_MODE=headless

# Database URL (Optional, default: sqlite:///data/jobs.db)
DATABASE_URL=sqlite:///data/jobs.db
